{
  "name": "interntrack-week3-backend",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest tests/unit tests/frontend/app.test.js --runInBand",
    "test:api": "jest tests/api.test.js --runInBand",
    "test:frontend": "jest tests/frontend/app.test.js --runInBand",
    "test:debug": "jest tests/unit/authController.test.js --runInBand -t \"non-string registration\"",
    "benchmark:lean": "node scripts/performance-benchmark.js",
    "benchmark:no-lean": "node scripts/performance-without-lean.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
